{
	"name": "@dsh-plugins/pr-badge",
	"version": "0.3.0",
	"description": "DSH web plugin: GitHub's pull-request octicon in every sidebar session row, colored by PR state (green open, orange blocked, purple merged), click-through to the right pull or merge request",
	"keywords": [
		"dsh-plugin",
		"deepseek-harness",
		"deepseek",
		"cordis",
		"git",
		"github",
		"gitlab",
		"pull-request",
		"sidebar"
	],
	"homepage": "https://github.com/tribesman/dsh-pr-badge#readme",
	"bugs": {
		"url": "https://github.com/tribesman/dsh-pr-badge/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tribesman/dsh-pr-badge.git"
	},
	"license": "MIT",
	"author": {
		"name": "tribesman",
		"url": "https://github.com/tribesman"
	},
	"type": "module",
	"main": "./lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node test/run.mjs && node test/client-check.mjs",
		"check": "node --check lib/index.js && node --check lib/client.js"
	},
	"engines": {
		"node": ">=22"
	},
	"dsh": {
		"client": {
			"platform": "web",
			"inject": []
		}
	}
}
